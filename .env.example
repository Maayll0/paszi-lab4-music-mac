# Run python scripts/init_env.py to generate .env with random local secrets.
POSTGRES_USER=musicaccess
POSTGRES_DB=musicaccess
POSTGRES_PASSWORD=
# Optional complete SQLAlchemy URL. Empty = assemble from POSTGRES_* and DB_HOST.
DATABASE_URL=
APP_ENV=development
HASH_SCHEME=argon2id
# Reserved for future signed features; opaque database sessions do not use this key.
SECRET_KEY=
# Public frontend port; the backend container listens on 8000.
PORT=8080
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2
SEED_DEMO_USERS=true
DEMO_PUBLIC_PASSWORD=
DEMO_CONFIDENTIAL_PASSWORD=
DEMO_SECRET_PASSWORD=
